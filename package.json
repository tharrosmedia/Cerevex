{
  "name": "cerevex-monorepo",
  "private": true,
  "description": "Cerevex monorepo — console (apps/brain) + ads module (apps/ads)",
  "workspaces": [
    "apps/*",
    "apps/ads/*",
    "jobs/seo",
    "jobs/meta/*",
    "jobs/google/*",
    "packages/*",
    "connectors/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@cerevex/brain",
    "build": "npm run build --workspace=@cerevex/brain",
    "start": "npm run start --workspace=@cerevex/brain",
    "typecheck": "npm run typecheck --workspace=@cerevex/brain && npm run typecheck --workspace=@cerevex/jobs-seo && npm run typecheck --workspace=@cerevex/contracts && npm run typecheck --workspace=@cerevex/connector-wordpress && npm run typecheck --workspace=@cerevex/connector-shopify",
    "typecheck:brain": "npm run typecheck --workspace=@cerevex/brain",
    "typecheck:seo": "npm run typecheck --workspace=@cerevex/jobs-seo",
    "test": "npm run test --workspace=@cerevex/brain",
    "db:migrate": "npm run db:migrate --workspace=@cerevex/brain",
    "trigger:seo": "npm run trigger:seo --workspace=@cerevex/brain",
    "test:shopify": "npm run test:shopify --workspace=@cerevex/brain",
    "inngest:sync": "npm run inngest:sync --workspace=@cerevex/brain",
    "test:prompt": "npm run test:prompt --workspace=@cerevex/brain",
    "ingest:knowledge": "npm run ingest:knowledge --workspace=@cerevex/brain",
    "ads:dev": "npm run dev --workspace=@tharros/ads",
    "ads:typecheck": "npm run typecheck --workspace=@tharros/ads",
    "ads:test": "npm run test --workspace=@tharros/ads",
    "ads:db:up": "npm run db:up --workspace=@tharros/ads",
    "ads:db:down": "npm run db:down --workspace=@tharros/ads",
    "ads:db:migrate": "npm run db:migrate --workspace=@tharros/ads",
    "ads:db:seed": "npm run db:seed --workspace=@tharros/ads"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC"
}
