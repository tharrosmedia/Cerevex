# Cerevex console env (apps/brain). Copy to apps/brain/.env
# OS does not share this APP_PASSWORD and does not use this public/pgvector schema.
# Database (Neon) — Brain only
DATABASE_URL=

# LLM + Embeddings
XAI_API_KEY=               # required for xAI (grok-4.6)
XAI_MODEL=                 # optional; defaults to grok-4.6 (override to pin a different model)
OPENAI_API_KEY=            # optional: for embeddings (text-embedding-3-small). If missing or no credits, falls back to text search only.

# Search (research step) — Brain SEO only. OS does not require Tavily.
TAVILY_API_KEY=

# Shopify credentials are now stored per-store in the DB (see /stores UI)
# These env vars are only used as fallback if no store record exists
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_API_KEY=   # management key from Inngest dashboard (API Keys) for /v2/apps/.../syncs; separate from event/signing keys
# PUBLIC_URL=        # base domain e.g. https://cerevex.store  (code appends /api/inngest)
# INNGEST_APP_ID=Cerevex    # Brain SEO + WordPress jobs. Default Cerevex. Do not use cerevex-ads.

# App
PORT=3000
# Brain console session only. Not ads JWT. Not a capability / feature flag.
APP_PASSWORD=change-this-to-secure-password
# Ads cockpit BFF (server-side only — do not expose ads-web to operators)
# ADS_API_URL=http://127.0.0.1:43180
# ADS_INTERNAL_KEY=          # service secret for x-cerevex-internal-key; not a feature flag
# ADS_API_TOKEN=             # optional ads JWT the BFF can send; not a feature flag
# Leftover chrome links: set NEXT_PUBLIC_ADS_LEGACY_CHROME=1 AND turn on
# shell.legacy_ads_web. In-shell /ads is the operator path. Do not set these
# unless leftover ads-web is intentionally deployed.
# NEXT_PUBLIC_ADS_LEGACY_CHROME=
# NEXT_PUBLIC_ADS_ORIGIN=
# DEV_STORE_ID=11111111-1111-1111-1111-111111111111   # optional fixed UUID for v1 scoping

# Encryption for sensitive DB fields (e.g. Shopify tokens). Generate a strong random string (32+ chars)
ENCRYPTION_KEY=

# Sentry (error monitoring, tracing, replays, logs)
# Get DSNs from your Sentry project settings. SENTRY_AUTH_TOKEN is for source map uploads (create at sentry.io settings)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=          # e.g. your-org-slug (for builds)
SENTRY_PROJECT=      # e.g. shopify-brain (for builds)
