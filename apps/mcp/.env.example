# cerevex-mcp. Copy to apps/mcp/.env for local runs. Never commit real secrets.
# The process does not open a database. Audit writes, token checks, and the
# connector kill switch go through the ads API (ADS_API_URL + MCP_SERVICE_KEY).

# Bind address. Local default is loopback. Railway start command sets 0.0.0.0.
HOST=127.0.0.1
# Railway injects PORT. Local default when unset is 4320.
PORT=4320

# Comma-separated origins. A present Origin that is not on this list is 403.
# An absent Origin is allowed (non-browser agents). No wildcard, no implicit localhost.
MCP_ALLOWED_ORIGINS=

# Emergency brake only. Any non-empty value forces the connector off (403).
# It cannot turn the connector on. Leave unset to follow the workspace flag
# settings_json.mcpConnectorKillSwitch, which stays off until an owner sets it
# to boolean false. The ads API applies the same rule to its own copy. Either
# process being set forces the connector off.
MCP_CONNECTOR_KILL_SWITCH=

# Ads API origin (scheme, host, port). No path, userinfo, query, or fragment.
ADS_API_URL=
# Scoped principal for this service only. Header x-cerevex-mcp-key.
# Not ADS_INTERNAL_KEY. It cannot call the rest of the ads API.
# The value must differ from ADS_INTERNAL_KEY. Header only. Never a query param.
MCP_SERVICE_KEY=
