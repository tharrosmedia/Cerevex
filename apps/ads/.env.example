# Cerevex ads module — local / Railway / Neon environment
# Copy to apps/ads/.env (or repo-root .env). Never commit real secrets.
# Brain env stays in apps/brain/.env (APP_PASSWORD). Do not share auth.
# Neon schema name remains "os" — do not rename it in this file or in prod.

# --- Database (local docker-compose default in apps/ads) ---
# Migrations create/use schema "os". Local compose default below.
# Shared Neon smoke (same Brain project): paste Brain DATABASE_URL and follow SMOKE.md.
# Do not point this at Brain public/pgvector. Do not seed production from this file.
# The seed script and ads API tests refuse a non-local host unless it is a known test
# database or a Neon branch. ALLOW_NONLOCAL_TEST_DB=1 allows another host. That opt-in
# still refuses the host named by PRODUCTION_NEON_HOST or PRODUCTION_DATABASE_URL.
# TODO(blocker): Brain production DATABASE_URL not granted to agents yet.
DATABASE_URL=postgres://tharros:tharros@127.0.0.1:54329/tharros

# --- Inngest (async jobs — no Redis, no BullMQ, no Zapier, no Tavily) ---
# Local: INNGEST_DEV points the SDK at the Dev Server started by `pnpm dev:inngest`.
# Cloud keys come from Adam / CoS — leave these blank until granted. Do not invent secrets.
INNGEST_DEV=http://127.0.0.1:43183
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local default app id is cerevex-ads so Brain seo-* sync is not overwritten.
# Production: reuse Brain Inngest Cloud keys; do not provision a second org.
# OS_INNGEST_APP_ID=cerevex-ads

# --- Token encryption (OAuth tokens at rest) ---
# 32-byte utf8 or 64-char hex. Local default is used only when this is unset outside a production runtime.
# A production runtime is NODE_ENV / RAILWAY_ENVIRONMENT / RAILWAY_ENVIRONMENT_NAME equal to
# production after trim and case-folding, OR any other non-empty Railway environment name
# (staging, production-eu, …), OR CEREVEX_REQUIRE_SIGNING_SECRETS=1, true, or yes.
# Cerevex Railway production is literally named production. A different Railway name still
# refuses this placeholder (any case), a value shorter than 32 Unicode code points, and an empty value.
# The raw value is not trimmed. Leading or trailing whitespace fails ads-api and ads-worker boot.
# Required on both ads-api and ads-workers. JWT_SECRET is not required on workers.
TOKEN_ENCRYPTION_KEY=local-dev-only-token-key-32b!!

# --- Meta Marketing API (ads_read + ads_management). Leave blank for mock connect. ---
# TODO(blocker): Adam/CoS grant Meta developer app via vault — not chat.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:43180/oauth/meta/callback

# --- Google Ads API (adwords). Leave blank for mock connect. ---
# TODO(blocker): Adam/CoS grant Google OAuth client + Ads developer token via vault — not chat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_REDIRECT_URI=http://127.0.0.1:43180/oauth/google/callback

# Soft-launch Approve identity allowlist (comma-separated). Single path.
# Default adam@tharrosmedia.com. Not a capability — do not put emails in settings_json.
# Still ANDed with apply + kill switch + freeze. SEED_OWNER_EMAIL is seed-only.
# APPROVE_OPERATOR_EMAILS=adam@tharrosmedia.com
# Bid/budget mutations ON under Approve. Set to 0 to roll back that class (legacy → apply.bid / apply.budget).
# FEATURE_BID_MUTATIONS=1
# FEATURE_BUDGET_MUTATIONS=1
# Live Meta/Google pull + apply. Set to 0 to force mock (legacy → sync.live).
# PLATFORM_SYNC_LIVE=1
# Optional global capability kills (no Site Brain redeploy). Workspace flags still live in settings_json.
# CAPABILITY_KILL=apply,connect.meta
# CAPABILITY_KILL_AUDITS=1
# CAPABILITY_KILL_SYNC_LIVE=1
# CAPABILITY_KILL_M52_CALLRAIL_CONNECT=1
# CAPABILITY_KILL_M52_BUNDLED_CALL_TRACKING=1
# CAPABILITY_KILL_M52_CRM_JOIN=1
# CAPABILITY_KILL_M52_LEAD_LIFECYCLE=1
# CAPABILITY_KILL_M52_BOOKED_JOB_SIGNAL=1
# CAPABILITY_KILL_M52_CLARITY_CONNECT=1
# CAPABILITY_KILL_M52_LP_INTELLIGENCE=1

# --- CallRail (M5.2 Phase A). Optional. Prefer the in-app encrypted store. ---
# Leave blank to use mock connect. Never commit a real key.
# CALLRAIL_API_KEY=
# CALLRAIL_ACCOUNT_ID=

# --- Bundled call tracking (M5.2 Phase B, Twilio-class lean). Optional. ---
# Leave blank to use mock connect. Never commit a real token.
# Does not buy numbers or change routing.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_TRACKING_NUMBER=

# --- Housecall Pro (M5.2 Phase D). Optional. Prefer the in-app encrypted store. ---
# Leave blank to use mock connect. Never commit a real key.
# Connect/pull never write HCP. Approve gates any CRM or ads write.
# HCP_API_KEY=

# --- Clarity (M5.2 Phase C). Optional. Prefer the in-app encrypted store. ---
# Leave blank to use mock connect. Never commit a real token.
# Aggregated session signals only — no in-house heatmap recorder.
# CLARITY_API_KEY=
# CLARITY_PROJECT_ID=

# --- Auth ---
# Ads user JWT — separate from Brain APP_PASSWORD. Secrets, not feature flags.
# Production runtime (same rule as TOKEN_ENCRYPTION_KEY): the name production after
# trim and case-folding, any other non-empty RAILWAY_ENVIRONMENT or
# RAILWAY_ENVIRONMENT_NAME, or CEREVEX_REQUIRE_SIGNING_SECRETS=1, true, or yes.
# Cerevex Railway production is literally named production. Another Railway name
# does not keep the local fallback. The value is trimmed. Length is Unicode code points.
# Unset, empty, whitespace, shorter than 32 code points, or this placeholder in any
# case exits ads-api boot with status 1. Ads workers do not read JWT_SECRET and boot
# without it. Dev and test use the local fallback when the value is unset, empty,
# or whitespace. Never deploy the placeholder.
# CEREVEX_REQUIRE_SIGNING_SECRETS=
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRES_IN=7d
# Shared with the Cerevex console BFF (server-side only). When set, the shell
# can read audits / findings / recommendations without exposing ads-web.
# ADS_INTERNAL_KEY=
# Workspace UUID for that key. Required in production when ADS_INTERNAL_KEY is set.
# Leave unset here. Do not guess a tenant, and do not commit a real id.
# ADS_INTERNAL_WORKSPACE_ID=
# CONSOLE_ORIGIN=http://localhost:3000

# Seeded owner (local only). Change before any shared deploy.
SEED_OWNER_EMAIL=adam@tharrosmedia.com
SEED_OWNER_NAME=Adam
SEED_OWNER_PASSWORD=local-dev-only

# Skill-config approval owner. A profile approval_owner of TBD or "agency owner"
# resolves to this identity. The import stores the name on
# os.skill_client_configs.approval_owner_resolved.
# It binds approval_owner_user_id to APPROVAL_OWNER_USER_ID only when that
# user exists and is an owner of every workspace that holds a linked client.
# Otherwise it binds the user for DEFAULT_APPROVE_OPERATOR_EMAIL only when
# that user is an owner of the workspace that holds the linked os.clients rows.
# An explicit id that is not an owner of the client's workspace is refused.
# Another workspace's owner is refused, and the import fails closed.
# The import is a write path: local hosts only, unless PRODUCTION_NEON_HOST
# or PRODUCTION_DATABASE_URL is set and the target host is not that production
# host. ALLOW_NONLOCAL_TEST_DB alone is not enough.
# This value is a name, not an email. The Approve allowlist email is
# DEFAULT_APPROVE_OPERATOR_EMAIL in packages/contracts/src/approve-allowlist.ts
# (APPROVE_OPERATOR_EMAILS above, SEED_OWNER_EMAIL for the local seed user).
APPROVAL_OWNER_NAME=agency owner (Adam Leech)
# APPROVAL_OWNER_USER_ID=

# --- Services ---
API_HOST=127.0.0.1
API_PORT=43180
WEB_PORT=43181
WORKER_PORT=43182
WEB_ORIGIN=http://127.0.0.1:43181
API_PUBLIC_URL=http://127.0.0.1:43180
NEXT_PUBLIC_API_URL=http://127.0.0.1:43180
# Shared Cerevex shell — ads chrome links back to the console
# NEXT_PUBLIC_CONSOLE_ORIGIN=http://localhost:3000
LOG_LEVEL=info
NODE_ENV=development

# --- Railway / Neon (M1 documented, not required to run locally) ---
# TODO(blocker): Railway project + service tokens not granted yet.
# RAILWAY_TOKEN=
# NEON_API_KEY=
